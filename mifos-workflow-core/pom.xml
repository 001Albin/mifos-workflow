<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.mifos</groupId>
        <artifactId>mifos-workflow</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mifos-workflow-core</artifactId>
    <packaging>jar</packaging>
    <name>mifos-workflow-core</name>
    <description>Engine-agnostic SPI contract and shared domain classes</description>

    <dependencies>

        <!--
            spring-context and spring-boot-autoconfigure:
            The parent declares these at default (compile+runtime) scope.
            Core must override to PROVIDED scope so Spring is NOT
            bundled into the core JAR — it is supplied by the app module.
            SECURITY: keeps core a plain library with no embedded server.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            ArchUnit: NOT in the parent pom — this is the only
            truly new dependency added for this module.
            test scope only — never ships in production JAR.
            SECURITY: enforces zero engine imports in core at build time.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Lombok annotation processor path must be declared
                explicitly in child modules for javac to process
                @Builder, @Data, @Slf4j correctly.
                This is not extra — it mirrors what the root pom does
                for the monolith build.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>